  "narrative": {
    "northStar": "沉稳的交易工作台",
    "overview": "界面沉稳、清晰，以任务和数据可读性为先。信息密度适中，使用克制的色彩、边框和卡片组织账户与策略信息；按钮、卡片和输入框保持清晰、便于操作。",
    "keyCharacteristics": [
      "深松绿与雾灰绿构成工作台的基础，暖陶红区分做空及负值。",
      "数字使用等宽字体和表格数字，便于扫描比较。",
      "浅色、深色和跟随系统三种主题共存。"
    ],
    "rules": [],
    "dos": [
      "保持浅色和深色主题中的状态及数据可读性。",
      "用文字或图标补充交易方向和状态色。",
      "保持数字对齐、支持窄屏及长数值换行。"
    ],
    "donts": [
      "仅凭颜色传达方向、风险或运行状态。",
      "让装饰或动画妨碍数据扫描及操作。"
    ]
  }
}
