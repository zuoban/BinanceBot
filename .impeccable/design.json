      "css": ".ds-m{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid #e1e7ef}.ds-m>div{padding:12px 20px;display:flex;flex-direction:column;gap:3px}.ds-m span{font-size:12px;color:#44546a}.ds-m strong{font:500 13px ui-monospace,Menlo,monospace}"
    }
  ],
  "narrative": {
    "northStar": "市场天气预报",
    "overview": "平时安静，异常时分级。状态沿用气象预警的四级信号语法（蓝、黄、橙、红），每一级都带图标和文字，不单靠颜色。深海军蓝侧栏固定为深色，右侧是偏冷的浅灰蓝工作区，操作色只用信号蓝。",
    "keyCharacteristics": [
      "左侧固定侧栏加 ⌘K 命令面板",
      "五级信号标签统一表达状态",
      "卡片只用 1px 边框，不用阴影",
      "数字使用等宽字体与 tabular-nums",
      "浅色、深色、跟随系统三种主题"
    ],
    "rules": [
      {
        "name": "图标加文字规则",
        "body": "每个状态、方向和风险同时给图标和文字，颜色只是第三条通道。",
        "section": "colors"
      },
      {
        "name": "平面规则",
        "body": "面板只用 1px 边框分层；阴影只给浮层和吸底保存栏。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 每个状态同时给图标和文字。",
      "Do 数字右对齐、等宽、支持窄屏换行。",
      "Do 实盘、模拟盘和数据过期始终可见。"
    ],
    "donts": [
      "Don't 仅凭颜色传达方向、风险或运行状态。",
      "Don't 在卡片里再嵌套卡片，或用阴影代替边框。",
      "Don't 让装饰或动画妨碍数据扫描及操作。"
    ]
  }
