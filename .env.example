# 复制为 .env，Docker Compose 自动传入容器：docker compose up -d --build
# 每次启动：数据库/TOML < 公共环境变量 < 单交易对环境变量 < 命令行。
# 未声明的变量沿用数据库；本文件不控制运行/暂停状态。

# 逗号分隔；列表中的交易对同时运行，也支持仅填写一个交易对。
TRADING_PAIRS=SOLUSDC,BTCUSDT

# Binance 共享设置；默认模拟盘，无需 API 凭证。
BINANCE_DRY_RUN=true
BINANCE_TESTNET=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW=5000
BINANCE_SYNC_INTERVAL_SECS=3

# 公共网格参数，所有交易对共用，可在下方逐交易对覆盖。
# *_USDC 是历史字段名；金额实际使用交易对的计价资产 (USDC/USDT)。
GRID_INTERVAL=0.1
GRID_ORDER_AMOUNT_USDC=100
GRID_BUY_WINDOW=5
GRID_SELL_WINDOW=5
GRID_POST_ONLY=true
GRID_MAX_POSITION_USDC=2000
GRID_PAUSE_ON_MAX_POSITION=false
# 可选限制：不声明时保留数据库的值，声明空值时清除该限制。
# GRID_MIN_PRICE=
# GRID_MAX_PRICE=

# 单交易对覆盖：PAIR_<大写交易对>_<公共变量名>
PAIR_SOLUSDC_GRID_INTERVAL=0.1
PAIR_BTCUSDT_GRID_INTERVAL=10
PAIR_BTCUSDT_GRID_BUY_WINDOW=3
PAIR_BTCUSDT_GRID_SELL_WINDOW=3
PAIR_BTCUSDT_GRID_MAX_POSITION_USDC=1500
# 其他按交易对覆盖的示例：
# PAIR_BTCUSDT_GRID_ORDER_AMOUNT_USDC=150
# PAIR_BTCUSDT_BINANCE_DRY_RUN=true
# PAIR_BTCUSDT_BINANCE_TESTNET=false
# PAIR_BTCUSDT_BINANCE_API_KEY=
# PAIR_BTCUSDT_BINANCE_API_SECRET=
# PAIR_BTCUSDT_TELEGRAM_ENABLED=false

# Telegram 共享设置，交易对可使用同样的 PAIR_<SYMBOL>_ 前缀覆盖。
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WEB_PORT 为宿主机端口；SERVER_PORT 为容器内监听端口。
WEB_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=binance_grid_bot=info,tower_http=info
